# ─────────────────────────────────────────────────────────────────────────────
# SECRETOS del BACKEND (Supabase Edge Functions)
#
# Estas llaves NUNCA van en el frontend ni llevan prefijo VITE_.
#
# Este proyecto no usa la CLI de Supabase. Los secretos se cargan a mano en
#   Dashboard → Edge Functions → Secrets → Add new secret
# usando los nombres de abajo. Este archivo es solo la lista de referencia:
# no lo llenes con valores reales.
#
# No hace falta declarar SUPABASE_URL, SUPABASE_ANON_KEY ni
# SUPABASE_SERVICE_ROLE_KEY: Supabase las inyecta solas en cada Edge Function.
# ─────────────────────────────────────────────────────────────────────────────

# ── Cloudflare Turnstile: validar el token en el servidor ───────────────────
# Llave secreta de prueba que siempre pasa: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── Google Maps: geocodificar en el servidor para validar cobertura (RF-COB-08)
# Llave DISTINTA a la del frontend: habilita solo "Geocoding API" y restríngela
# por API (no por referrer, porque la usa el servidor).
GOOGLE_MAPS_SERVER_KEY=

# ── Correo transaccional: confirmaciones, recordatorios (RF-NOT-01) ─────────
# Resend → API Keys. El dominio del remitente debe estar verificado (SPF/DKIM).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Animayuks <reservas@animayuks.com>"
EMAIL_ADMIN=reservas@animayuks.com

# ── Pagos en línea (FASE 2): Mercado Pago ───────────────────────────────────
# Tus integraciones → Credenciales → Access token (TEST-... en pruebas).
MERCADOPAGO_ACCESS_TOKEN=
# Webhooks → clave secreta para validar la firma x-signature (RNF-SEG-12).
MERCADOPAGO_WEBHOOK_SECRET=

# Las fotos y videos de los shows van en Supabase Storage (bucket "shows"):
# no requieren llaves extra porque usan las credenciales que Supabase inyecta.

# ── Configuración del negocio ───────────────────────────────────────────────
APP_URL=https://animayuks.com
TZ_NEGOCIO=America/Mexico_City
