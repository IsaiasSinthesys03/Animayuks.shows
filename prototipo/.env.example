# ─────────────────────────────────────────────────────────────────────────────
# Variables del FRONTEND (React + Vite)
#
# Copia este archivo como `.env.local` y llena los valores. `.env.local` no se
# sube a git.
#
# IMPORTANTE: todo lo que empieza con VITE_ se incrusta en el JavaScript que
# descarga el navegador, así que es PÚBLICO. Aquí solo van llaves públicas o
# restringidas por dominio. Nunca pongas aquí una llave secreta (service role,
# secret key, access token de pagos, API key de correo).
# Esas van en supabase/.env.example.
#
# En Render, estas mismas variables se agregan en Environment del Static Site.
# Se leen al compilar: después de cambiarlas hay que volver a desplegar.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase: base de datos, autenticación, storage y realtime ──────────────
# Dashboard → Project Settings → API (o "API Keys").
# Usa la "Publishable key" (sb_publishable_...). En proyectos antiguos se llama
# "anon key". Es segura en el navegador SOLO si todas las tablas tienen RLS activo.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ── Cloudflare Turnstile: anti-bots en registro, login y reservación (RNF-SEG-08)
# Cloudflare Dashboard → Turnstile → Add widget. Agrega como dominios
# localhost, animayuks-shows.onrender.com, animayuks.com y www.animayuks.com.
# Llave de prueba que siempre pasa: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ── Google Maps Platform: autocompletado de direcciones y mapa (RF-COB-05, RF-COB-08)
# Habilita "Maps JavaScript API" y "Places API (New)".
# Restringe la llave por "HTTP referrers" a tus dominios para que nadie más la use.
VITE_GOOGLE_MAPS_API_KEY=

# ── Pagos en línea (FASE 2): llave PÚBLICA de la pasarela ───────────────────
# Mercado Pago: Tus integraciones → Credenciales → Public key (TEST-... en pruebas).
VITE_MERCADOPAGO_PUBLIC_KEY=

# ── Monitoreo de errores (opcional, RNF-OBS-02) ─────────────────────────────
VITE_SENTRY_DSN=

# ── Configuración de la app ─────────────────────────────────────────────────
VITE_APP_NAME=Animayuks
VITE_APP_URL=http://localhost:5173
# WhatsApp del dueño para los botones "Escríbenos" (enlaces wa.me, sin API).
# Formato internacional sin "+", espacios ni guiones: 52 + 10 dígitos.
VITE_WHATSAPP_NEGOCIO=523312345678
